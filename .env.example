# Variables de Minecraft2 (contrato común del Corte 3). Copiar a .env: cp .env.example .env
# Todos los valores son de ejemplo; .env no se versiona. No hay secretos en este archivo.

# Servidor (mc2-server)
MC2_SERVER_HOST=mc2-server
MC2_SERVER_PORT=7777
MC2_HEALTH_PORT=8080
MC2_TICK_HZ=20
# 0 en juego normal; 80 para la prueba de carga (SLO-CARGA-01).
MC2_LOAD_ZOMBIES=0
MC2_WORLD_DIR=/data/worlds

# Cliente (mc2-front)
MC2_PLAYER_NAME=jugador-ejemplo
# Apariencia del jugador: 0, 1 o 2.
MC2_SKIN_ID=0

# Dirección donde se publica noVNC (6080). 127.0.0.1: solo el equipo anfitrión (valor por defecto).
# 0.0.0.0 lo abre a la red local para una demostración; noVNC no pide contraseña.
MC2_FRONT_BIND=127.0.0.1

# Imagen a ejecutar: local construye desde el código; el despliegue usa el SHA del commit o la versión (vX.Y.Z).
MC2_IMAGE_TAG=local
MC2_REGISTRY=ghcr.io/marshallgomez1103
