<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.minecraft2</groupId>
    <artifactId>minecraft2</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Minecraft 2</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <gdx.version>1.12.1</gdx.version>
        <main.class>bootstrap.Minecraft2Application</main.class>
        <jacoco.version>0.8.15</jacoco.version>
        <skipUnitTests>false</skipUnitTests>
        <unitCoverageArgLine></unitCoverageArgLine>
        <integrationCoverageArgLine></integrationCoverageArgLine>
        <integration.test.patterns>**/application/CombatSessionRegressionTest.java,**/application/DifficultyTest.java,**/application/EnemyKamikazeTest.java,**/application/EnemyUpdateServiceIT.java,**/application/EnemyWallAttackTest.java,**/application/GameSessionTest.java,**/application/HordeManagerTest.java,**/application/HordeSpawnSafetyTest.java,**/application/LocalWorldPersistenceIT.java,**/application/PersistentPursuitTest.java,**/application/PistolServiceTest.java,**/application/PlayerInteractionPlacementTest.java,**/application/SameSeedTest.java,**/application/SaveEdgeCasesIT.java,**/application/WorldLifecycleIT.java,**/application/ZombieContactRegressionTest.java,**/application/ZombieMeleeServiceTest.java,**/application/ZombieTargetingTest.java,**/application/PlayerControlStaminaTest.java,**/application/PlayerControlServiceTest.java,**/bootstrap/WorldDirectoryTest.java,**/bootstrap/GpuPreferenceTest.java,**/persistence/JsonWorldStorageTest.java,**/presentation/MainMenuSettingsTest.java,**/presentation/game/VoxelGameObserverTest.java,**/presentation/game/GameWindowTextureModeTest.java,**/domain/enemy/ZombieSeparationTest.java,**/domain/world/TerrainGenerationTest.java,**/IT*.java,**/*IT.java,**/*ITCase.java</integration.test.patterns>
        <pitest.version>1.30.0</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
    </properties>

    <dependencies>
        <!-- LibGDX con backend de escritorio LWJGL3: la tecnología gráfica acordada en
             docs/decisiones-compartidas.md. Solo la usa el paquete presentation.game. -->
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx</artifactId>
            <version>${gdx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-lwjgl3</artifactId>
            <version>${gdx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>${gdx.version}</version>
            <classifier>natives-desktop</classifier>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Diseño de carpetas no estándar heredado del esqueleto inicial: las fuentes
             están en src/ y las pruebas en test/, en vez de src/main/java y src/test/java. -->
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>@{unitCoverageArgLine}</argLine>
                    <skipTests>${skipUnitTests}</skipTests>
                    <excludes><exclude>${integration.test.patterns}</exclude></excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>@{integrationCoverageArgLine}</argLine>
                    <includes><include>${integration.test.patterns}</include></includes>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>unit-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <propertyName>unitCoverageArgLine</propertyName>
                            <destFile>${project.build.directory}/jacoco-unit.exec</destFile>
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>unit-domain-report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-unit.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-domain-unit</outputDirectory>
                            <includes><include>domain/**</include></includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>integration-agent</id>
                        <goals><goal>prepare-agent-integration</goal></goals>
                        <configuration>
                            <propertyName>integrationCoverageArgLine</propertyName>
                            <destFile>${project.build.directory}/jacoco-integration.exec</destFile>
                            <append>false</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>integration-domain-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-integration.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-domain-integration</outputDirectory>
                            <includes><include>domain/**</include></includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Mutation testing (C2-09). No está atado a ninguna fase: `mvn clean test` no lo ejecuta.
                 Se lanza a mano con `mvn test-compile org.pitest:pitest-maven:mutationCoverage`.
                 El scope es lógica pura del Corte 2; ver docs/corte2/testing/mutation-testing.md. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>domain.enemy.ZombieStateMachine</param>
                        <param>domain.enemy.AStarPathfinder</param>
                        <param>domain.enemy.WaveRules</param>
                        <param>domain.enemy.Difficulty</param>
                        <param>domain.world.biome.BiomeResolver</param>
                        <param>application.HordeManager</param>
                        <param>application.GameSettings</param>
                    </targetClasses>
                    <targetTests>
                        <param>domain.*</param>
                        <param>application.*</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                        <param>CSV</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
            <!-- Empaqueta las dependencias y los binarios nativos de LibGDX dentro de un
                 único jar ejecutable. Sin esto, `java -cp target/classes` ya no basta. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
